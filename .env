# LubbaCMS Environment Configuration
# Copy this file to .env and configure your settings

# Environment (development/production)
ENVIRONMENT=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lubba
DB_USER=root
DB_PASS=

# Hotel Configuration
HOTEL_NAME=Lubba
HOTEL_URL=http://127.0.0.1
HOTEL_EMU_HOST=127.0.0.1
HOTEL_EMU_PORT=30000

# Security
SESSION_LIFETIME=3600
CSRF_PROTECTION=true
RATE_LIMIT_ENABLED=true

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=TLS

# Cloudflare (optional)
CLOUDFLARE_ENABLED=false

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MIN_RANK=3

# Logging
LOG_ERRORS=true
LOG_PATH=/logs/

# PHP Settings
PHP_DISPLAY_ERRORS=0
PHP_ERROR_REPORTING=E_ALL
